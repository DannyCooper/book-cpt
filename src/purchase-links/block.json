{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "book-cpt/purchase-links",
	"version": "1.0.0",
	"title": "Book Purchase Links",
	"category": "book-cpt",
	"icon": "cart",
	"description": "A buy button with a dropdown of bookstore links for the current book.",
	"keywords": [ "book", "books", "buy", "purchase", "retailer", "store", "shop", "links", "amazon" ],
	"textdomain": "book-cpt",
	"attributes": {
		"buttonLabel": {
			"type": "string",
			"default": "Buy this book"
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
